{
  "name": "argos",
  "version": "0.1.0",
  "description": "RSS stock news to WhatsApp",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "health": "node dist/health.js",
    "health:dev": "tsx src/health.ts"
  },
  "license": "MIT",
  "private": "true",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^12.11.1",
    "html-to-text": "^10.0.1",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "rss-parser": "^3.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/html-to-text": "^9.0.4",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
